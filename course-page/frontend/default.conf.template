# Plantilla: la imagen oficial de nginx procesa /etc/nginx/templates/ al arrancar
# y reemplaza cada ${VARIABLE} por su valor del entorno. Así la MISMA imagen sirve
# en compose, en QA y en PROD: lo único que cambia son las variables.
server {
    # Render le dice a cada servicio en qué puerto escuchar (PORT); en compose, 80.
    listen ${PORT};

    # [+] Los endpoints de subida de imágenes y archivos de curso mueven más de
    # 1 MB, que es el default de nginx: sin esto responde 413. La app del
    # documento no sube archivos, por eso allá no aparece.
    client_max_body_size 20M;

    # SPA: estáticos, con fallback a index.html para las rutas del router
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Todo lo que llegue a /api se reenvía al backend. La dirección y el DNS
    # llegan por variables: en compose, el nombre del servicio y el DNS de Docker
    # (same-origin para el browser, así que evita CORS — §2.6); en Render, la URL
    # de la api de ESTE entorno y un DNS público.
    #
    # 🔴 La dirección va en una VARIABLE de nginx, no escrita directo en el
    # proxy_pass. Con el nombre directo, nginx lo resuelve AL ARRANCAR y, si el
    # backend todavía no existe, se niega a levantar: «host not found in
    # upstream». Con variable, resuelve recién cuando llega un pedido.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    location /api/ {
        # [+] Esta API NO vive bajo /api: sus rutas son /courses, /users, /login…
        # El rewrite saca el prefijo antes de reenviar, así /api/courses llega al
        # backend como /courses.
        #
        # Y de paso cubre los estáticos del backend sin necesitar más bloques:
        # /api/images/Image-1.jpg  ->  /images/Image-1.jpg, que es lo que sirve
        # router.Static() en app/router.go. Lo mismo con /api/files/.
        #
        # (No se usa `proxy_pass $backend_api/;` porque cuando proxy_pass lleva
        #  una variable Y una URI, nginx manda esa URI literal y pierde el path.)
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_api;

        # La api de Render es https: sin esto el TLS no sabe a qué host va (SNI)
        proxy_ssl_server_name on;
    }
}
